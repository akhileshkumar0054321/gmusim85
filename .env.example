# SERVER ONLY. Never prefix API keys with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional secondary cloud provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional local model on the SAME machine as the Node server
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_ENABLED=false
# Deployed settings: set NODE_ENV=production; hosting usually sets PORT itself.
# HOST=0.0.0.0
# NODE_ENV=production
# APP_ORIGIN=https://your-site.example
# TRUST_PROXY=1
# Optional shared access code (up to 256 characters); entered in the assistant panel.
ASSISTANT_ACCESS_TOKEN=
# These safeguards are per running server, in memory, and reset on restart.
AI_REQUESTS_PER_MINUTE=8
AI_DAILY_REQUEST_LIMIT=200
AI_MAX_CONCURRENT=4
